{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Miofive Video Converter",
  "version": "1.0.0",
  "identifier": "com.dst.miofive-video-converter",
  "build": {
    "frontendDist": "../public",
    "beforeDevCommand": "npm run build:sidecar:demo",
    "beforeBuildCommand": "npm run build:sidecar"
  },
  "app": {
    "windows": [
      {
        "title": "Miofive Video Converter",
        "label": "main",
        "url": "index.html",
        "width": 1280,
        "height": 900,
        "minWidth": 960,
        "minHeight": 700,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; connect-src 'self' http://127.0.0.1:*; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; media-src 'self' blob: http://127.0.0.1:*; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Video",
    "resources": ["resources/**/*"],
    "externalBin": ["binaries/miofive-server"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
